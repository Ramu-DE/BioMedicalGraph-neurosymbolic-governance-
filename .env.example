# Copy to .env and fill in.  `.env` is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Values are read through config.py, which never prints a secret:
#   python config.py   -> readiness report with an 8-char fingerprint per secret
#
# NOTHING BELOW IS REQUIRED TO RUN THE TEST SUITE.
# `pytest` passes with no .env present at all.

# ── Neo4j: knowledge graph, identity, bitemporal facts ───────────────────────
# Aura: neo4j+s://<id>.databases.neo4j.io   Self-hosted: bolt://localhost:7687
# Aura Free caps near 200k nodes / 400k relationships; self-hosted is uncapped.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Some Aura instances name the single database after the instance id.
# scripts/verify_services.py reports the correct value.
NEO4J_DATABASE=neo4j

# ── Qdrant: vector store, payload-filtered by resolved graph identity ────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# ── Embeddings and LLM (optional) ───────────────────────────────────────────
# Without a provider the vector layer uses a deterministic hash stand-in. Every
# structural property stays testable; semantic quality is NOT measurable, and
# the readiness report says so on screen.
EMBEDDING_PROVIDER=none          # none | bedrock
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
LLM_PROVIDER=none                # none | bedrock

# AWS, only if EMBEDDING_PROVIDER or LLM_PROVIDER is bedrock.
# Model access must be enabled per-model in the Bedrock console for the region —
# valid credentials still fail until it is.
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Trust boundary (component 00) ───────────────────────────────────────────
# Versioned, because every verdict records which policy produced it.
TRUST_POLICY_VERSION=1.0
CONFIDENCE_FLOOR=0.75            # facts below this cannot be rule inputs
MIN_TIER=ingested                # asserted | ingested | derived | runtime
CONTRADICTION_ELIGIBLE=false     # contested facts ineligible by default

# ── Open sources: no API key required ───────────────────────────────────────
#   ClinicalTrials.gov v2 · RxNav/RxNorm · EBI OLS4 (MONDO) · HGNC · ChEMBL
# openFDA works unauthenticated at 1,000 req/day; a free key raises it to
# 120,000/day -> https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ── UI ──────────────────────────────────────────────────────────────────────
UI_PORT=8099
